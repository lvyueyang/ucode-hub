{
  "name": "hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @ucode/hub dev",
    "start": "pnpm --filter @ucode/hub start",
    "build": "pnpm --filter @ucode/hub build",
    "preview": "pnpm --filter @ucode/hub preview",
    "test": "pnpm --filter @ucode/hub test",
    "check": "biome check . && pnpm -r typecheck && pnpm -r test",
    "spike": "pnpm --filter @ucode/hub spike",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "e2e": "pnpm --filter @ucode/hub e2e",
    "db:generate": "pnpm --filter @ucode/hub db:generate",
    "db:migrate": "pnpm --filter @ucode/hub db:migrate",
    "db:pull": "pnpm --filter @ucode/hub db:pull",
    "db:studio": "pnpm --filter @ucode/hub db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
