{
  "extends": "../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "server.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts"
  ],
  "compilerOptions": {
    "paths": {
      "#/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
