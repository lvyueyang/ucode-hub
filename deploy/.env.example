# 生产部署的环境变量模板：复制为 .env 后填写
#   cp .env.example .env
#
# compose 用它注入应用的 DATABASE_URL 并透传可选变量（见 docker-compose.yml）；
# 变量清单与判定规则的事实源是 app/src/env.ts：必需项缺失或取值非法一律拒绝启动。

# 数据库

# SQLite 库文件路径（必须落在容器挂载卷内：默认 ./data/data.db = 宿主 volumes/app/data.db）
DATABASE_URL=./data/data.db
# 数据存储根目录（STORAGE_DIR）由 compose 固定注入为 /app/data（= 宿主 volumes/app），不在此配置：
# 改到卷外会让日志、上传文件随容器重建丢失。

# HS256 签名密钥：至少 32 个字符，用 `openssl rand -base64 48` 之类的随机值
JWT_SECRET=change-me-at-least-32-characters-long

# 端口

# 应用对外端口（只绑 127.0.0.1，由反代转发）
APP_PORT=3009

# 镜像 tag：deploy.sh 按它拉取并滚动更新
TAG=latest

# 可选变量：不设则用应用内默认值，设了必须合法

# 日志级别（fatal / error / warn / info / debug / trace）
LOG_LEVEL=info
# 认证 Cookie 是否带 Secure 标志：只接受 true / false；线上未启用 HTTPS 时必须设 false
COOKIE_SECURE=
# 系统配置敏感值加密主密钥：32 字节 Base64 或 64 位十六进制；密钥丢失则已加密的配置无法恢复
CONFIG_ENCRYPTION_KEY=
# ingress 回灌父域（如 hub.example.com）：设了才启用 <设备 id>.<父域> 的子域回灌，需泛域名解析与证书
HUB_BASE_DOMAIN=
